# --- Hyperliquid info API ---
HL_API_URL=https://api.hyperliquid.xyz/info
DEX_NAME=xyz

# --- Polling ---
POLL_INTERVAL_SEC=5

# --- PostgreSQL ---
PG_DSN=postgresql://user:password@host:5432/xyzbot

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Dry-run mode: log messages instead of sending them.
# (forced automatically if the token or chat_id is empty)
TELEGRAM_DRY_RUN=true
# Private/admin chat for ops alerts (API down…). If empty -> logs only.
TELEGRAM_ADMIN_CHAT_ID=
# Number of consecutive errors before the "API down" alert
API_DOWN_THRESHOLD=3

# --- Public status page (separate web service) ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
# DSN of a READ-ONLY Postgres role for the page (least privilege).
# If empty, the page reuses PG_DSN.
WEB_PG_DSN=postgresql://xyzbot_ro:password@localhost:5432/xyzbot
