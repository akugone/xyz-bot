# --- Hyperliquid info API ---
HL_API_URL=https://api.hyperliquid.xyz/info
DEX_NAME=xyz

# --- Polling ---
POLL_INTERVAL_SEC=5

# --- PostgreSQL (fournie par fb) ---
PG_DSN=postgresql://user:password@host:5432/xyzbot

# --- Telegram (canal cible à confirmer avec fb) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Mode dry-run : logue les messages au lieu de les envoyer.
# (forcé automatiquement si le token ou le chat_id est vide)
TELEGRAM_DRY_RUN=true

# --- Page de statut publique (service web séparé) ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
# DSN d'un rôle Postgres READ-ONLY pour la page (moindre privilège).
# Si vide, la page réutilise PG_DSN.
WEB_PG_DSN=postgresql://xyzbot_ro:password@localhost:5432/xyzbot
